{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Format code",
            "type": "shell",
            "command": "cargo fmt --",
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "Main application build",
            "type": "shell",
            "command": "cargo build",
            "dependsOn": ["Format code"],
            "group": {
                "kind": "build"
            },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Run clippy",
            "type": "shell",
            "command": "cargo clippy -- -D warnings",
            "dependsOn": ["Main application build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$rustc"]
        }
    ]
}